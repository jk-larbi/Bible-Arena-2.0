# Copy to backend/.env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
FRONTEND_ORIGINS=http://localhost:3000,https://YOUR-PRODUCTION-DOMAIN.vercel.app
ROOM_JOIN_BASE_URL=https://YOUR-PRODUCTION-DOMAIN.vercel.app/join
